<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template di shortcut ArtiPop: 2 azioni (Ottieni contenuto da URL -> Imposta sfondo).
  __ARTIPOP_URL__ viene sostituito da build_shortcuts.sh con l'URL del canale.
  Identifier delle azioni verificati sul formato moderno (iOS 16+):
    - is.workflow.actions.downloadurl
    - is.workflow.actions.wallpaper.set

  ⚠️ WFWallpaperShowPreview = false È LA RIGA PIÙ IMPORTANTE DI QUESTO FILE.
  Con l'anteprima ATTIVA (il default di iOS) l'azione "Imposta sfondo" apre un
  foglio di conferma: a mano l'utente tocca "Imposta" e sembra tutto a posto, ma
  in un'automazione a tempo — che gira headless, spesso a telefono bloccato —
  quella UI non può essere mostrata e l'azione muore in silenzio. È esattamente
  il sintomo "funziona a mano ma non in automazione".
  Chiave verificata su tre fonti indipendenti: le stringhe di ActionKit nella
  dyld shared cache di macOS 26.1 (blocco "ActionKit42": is.workflow.actions.
  wallpaper.set → WFSetWallpaperAction → WFWallpaperShowPreview → "Show Preview"),
  il decompilato di WFSetWallpaperAction.m (parameterValueForKey:@"WFWallpaper
  ShowPreview") e i corpus pubblici di shortcut. È un boolean plist nudo: NON va
  avvolto in un WFSerializationType.
  Gli altri parametri dell'azione (WFWallpaperLocation, WFWallpaperSmartCrop,
  WFWallpaperLegibilityBlur, WFWallpaperPerspectiveZoom, WFSelectedPoster) sono
  lasciati ASSENTI di proposito: così l'azione usa i propri default (schermata di
  blocco + home) senza rischiare errori di tipo su valori che non possiamo
  provare qui. Chi vuole solo la home li imposta a mano dopo l'import.
-->
<plist version="1.0">
<dict>
  <key>WFWorkflowActions</key>
  <array>
    <dict>
      <key>WFWorkflowActionIdentifier</key>
      <string>is.workflow.actions.downloadurl</string>
      <key>WFWorkflowActionParameters</key>
      <dict>
        <key>UUID</key><string>1A2B3C4D-0001-0000-0000-000000000001</string>
        <key>CustomOutputName</key><string>Wallpaper Image</string>
        <key>WFHTTPMethod</key><string>GET</string>
        <key>WFURL</key><string>__ARTIPOP_URL__</string>
      </dict>
    </dict>
    <dict>
      <key>WFWorkflowActionIdentifier</key>
      <string>is.workflow.actions.wallpaper.set</string>
      <key>WFWorkflowActionParameters</key>
      <dict>
        <key>UUID</key><string>1A2B3C4D-0002-0000-0000-000000000002</string>
        <key>WFInput</key>
        <dict>
          <key>WFSerializationType</key><string>WFTextTokenAttachment</string>
          <key>Value</key>
          <dict>
            <key>Type</key><string>ActionOutput</string>
            <key>OutputName</key><string>Wallpaper Image</string>
            <key>OutputUUID</key><string>1A2B3C4D-0001-0000-0000-000000000001</string>
          </dict>
        </dict>
        <!-- Anteprima SPENTA: senza questa riga l'automazione non funziona. -->
        <key>WFWallpaperShowPreview</key><false/>
        <!-- "Ritaglia sul soggetto" SPENTO: l'immagine è già composta a misura di
             lock screen, il ritaglio automatico ne sposterebbe l'inquadratura. -->
        <key>WFWallpaperSmartCrop</key><false/>
      </dict>
    </dict>
  </array>
  <key>WFWorkflowClientVersion</key><string>2038.0.2.4</string>
  <key>WFWorkflowMinimumClientVersion</key><integer>900</integer>
  <key>WFWorkflowMinimumClientVersionString</key><string>900</string>
  <key>WFWorkflowIcon</key>
  <dict>
    <key>WFWorkflowIconGlyphNumber</key><integer>61440</integer>
    <key>WFWorkflowIconStartColor</key><integer>4292093695</integer>
  </dict>
  <key>WFWorkflowImportQuestions</key><array/>
  <key>WFWorkflowTypes</key><array/>
  <key>WFWorkflowInputContentItemClasses</key>
  <array>
    <string>WFImageContentItem</string>
    <string>WFURLContentItem</string>
    <string>WFStringContentItem</string>
  </array>
</dict>
</plist>
