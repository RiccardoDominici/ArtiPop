# loop.config — configurazione per-progetto del motore autoloop (ArtiPop v3).
#
# Righe "CHIAVE=valore", sourcabile da bash E parsabile da monitor.py/
# start-loop.sh con un parser banale (KEY=..., commenti #, espansione di
# $HOME e ~). NIENTE array bash, niente logica: le liste sono stringhe
# spazio-separate (vedi NODE_WORKSPACES). Dettagli: docs/DESIGN.md §3 nel
# repo motore.

# --- identità ---
PROJECT_NAME="ArtiPop v3"
PROJECT_SLUG="artipop"
PROJECT_LABEL="ArtiPop loop"
NTFY_TOPIC="riccardo-claude"

# --- host ---
ENGINE_DIR="$HOME/Developer/autoloop"
ENV_FILE="$HOME/.artipop-loop.env"

# --- comportamento ---
TEST_CMD="cd backend && npx vitest run"
DEPLOY_ENABLED=1
VISUAL_ENABLED=1
PRODUCTION_BRANCH="auto/production"
CYCLE_BRANCH_PREFIX="auto/"
MAX_RUNS_DEFAULT=20
QUOTA_MARGIN_PCT_DEFAULT=90

# --- container ---
NODE_WORKSPACES=". backend"
EXTRA_MOUNTS="$HOME/Library/Preferences/.wrangler:/root/.config/.wrangler"

# --- governance ---
SECRET_ENV_NAMES="CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID PREVIEW_ADMIN_KEY ADMIN_KEY"
